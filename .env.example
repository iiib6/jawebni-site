# Copy to .env and fill in. .env is gitignored — never commit real values.
# NOTE: no default passwords exist in the code. ADMIN_PASS is required in
# production (Render); locally a random one is printed to the console if unset.

# --- Required in production (server exits if ADMIN_PASS is missing on Render) ---
ADMIN_USER=admin
ADMIN_PASS=

# --- Google AI ---
GEMINI_API_KEY=
# Optional: JSON of a GCP service account, used for Vertex AI instead of the key
GCP_SERVICE_ACCOUNT=

# --- Database ---
# Leave empty to use the local SQLite file (leads.db). Set on Render to Postgres.
DATABASE_URL=

# --- Lead notifications ---
ADMIN_NOTIFICATION_EMAIL=
GOOGLE_WEBHOOK_URL=
SMTP_USER=
SMTP_PASS=

# --- Reverse proxy topology (controls IP-based rate limiting) ---
# 0 = no proxy, use the direct socket peer (plain `python server.py`, LAN)
# 1 = one proxy hop        (Render default, serveo.net tunnel)
# 2 = two proxy hops       (Cloudflare in front of Render)
TRUSTED_PROXY_HOPS=
